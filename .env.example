# =====================================================
# ALGO-TRADER-NEXT ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =====================================================
# DATABASE
# =====================================================
MONGODB_URI=mongodb://localhost:27017/algotrader
# For production: mongodb+srv://user:password@cluster.mongodb.net/algotrader

# =====================================================
# NEXTAUTH CONFIGURATION
# =====================================================
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-change-this-in-production
# Generate with: openssl rand -base64 32

# =====================================================
# GOOGLE OAUTH (Optional)
# =====================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =====================================================
# APPLICATION SETTINGS
# =====================================================
NODE_ENV=development
PORT=3000

# =====================================================
# TRADING SAFETY CONFIGURATION
# ⚠️  CRITICAL: DO NOT ENABLE LIVE TRADING WITHOUT UNDERSTANDING RISKS
# =====================================================
# Set to 'true' to enable live trading (requires admin confirmation)
LIVE_TRADING=false

# Must be set to 'YES' (exact string) to allow real trades
# This is an additional safety measure
ALLOW_REAL_TRADES=NO

# =====================================================
# RISK MANAGEMENT PARAMETERS
# =====================================================
MAX_EXPOSURE_PERCENT=10
MAX_POSITIONS=5
PER_TRADE_MAX_RISK_PERCENT=1
DAILY_MAX_LOSS_PERCENT=5

# Trading window (IST) - format: HH:MM-HH:MM
TRADING_TIME_WINDOW=09:15-15:30

# =====================================================
# BROKER API KEYS (OPTIONAL - FOR LIVE TRADING ONLY)
# ⚠️  Keep these secret! Never commit to git!
# =====================================================

# Zerodha Kite Connect
# Get from: https://kite.trade/
ZERODHA_API_KEY=your-zerodha-api-key
ZERODHA_API_SECRET=your-zerodha-api-secret
ZERODHA_REQUEST_TOKEN=

# Upstox
# Get from: https://upstox.com/developer/
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=mongodb+srv://lavish6377289324:lavish6377289324@cluster0.83rih.mongodb.net/?appName=Cluster0

# =====================================================
# ML MODEL CONFIGURATION
# =====================================================
# Path to save trained models
MODELS_DIR=./models_tf

# Model parameters
MODEL_EPOCHS=50
MODEL_BATCH_SIZE=32
MODEL_VALIDATION_SPLIT=0.2

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=info
LOG_DIR=./logs

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# PAPER TRADING
# =====================================================
PAPER_INITIAL_CAPITAL=100000
PAPER_COMMISSION_PERCENT=0.05

# =====================================================
# DEFAULT ADMIN USER (for seeding)
# =====================================================
DEFAULT_ADMIN_EMAIL=admin@algotrader.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
# ⚠️  CHANGE THIS PASSWORD IMMEDIATELY AFTER FIRST LOGIN!
